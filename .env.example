APP_ENV=development

DATABASE_URL=

OPENAI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local GROBID HTTP service configuration; it does not require a credential.
GROBID_BASE_URL=http://127.0.0.1:8070
GROBID_TIMEOUT=300

# Docling remains in a separately managed optional environment.
DOCLING_EXECUTABLE=docling
DOCLING_TIMEOUT=900
DOCLING_DEVICE=cpu
