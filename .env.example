APP_ENV=development

DATABASE_URL=

OPENAI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local GROBID HTTP service configuration; it does not require a credential.
GROBID_BASE_URL=http://127.0.0.1:8070
GROBID_TIMEOUT=300

# Docling remains in a separately managed optional environment.
DOCLING_EXECUTABLE=docling
DOCLING_TIMEOUT=900
DOCLING_DEVICE=cpu

# Optional polite-pool identification for public metadata APIs. Leave blank to
# use anonymous public access; never commit a personal email into source code.
CROSSREF_MAILTO=
CROSSREF_TIMEOUT=20
OPENALEX_MAILTO=
OPENALEX_TIMEOUT=20
METADATA_USER_AGENT=paper-knowledge-base/0.1 (metadata resolution)
